---
import { contactHref } from "../utils/contactHref";
import PdfButton from "./PdfButton.astro";
import VersionToggle from "./VersionToggle.astro";

interface Props {
  name: string;
  role: string;
  contact: Array<{ value: string }>;
  otherVersion?: { href: string; label: string };
}

const { name, role, contact, otherVersion } = Astro.props;
---

<header class="resume-header-bar">
  <div class="header-identity">
    <h1 class="resume-name">{name}</h1>
    <p class="subtitle">{role}</p>
    {
      contact.length > 0 && (
        <div class="contact">
          {contact.map((c) => {
            const href = contactHref(c.value);
            return href ? <a href={href}>{c.value}</a> : <span>{c.value}</span>;
          })}
        </div>
      )
    }
  </div>
  <div class="header-actions">
    {
      otherVersion && (
        <VersionToggle href={otherVersion.href} label={otherVersion.label} />
      )
    }
    <PdfButton />
  </div>
</header>

<style>
  .resume-header-bar {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }
</style>
