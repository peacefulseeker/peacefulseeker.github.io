---
import type { ExperienceEntry } from "../utils/resumeSchema";

interface Props {
  experience: ExperienceEntry[];
}

const { experience } = Astro.props;
---

{
  /* Markup only — all `.xp-*` styling (incl. the timeline rail decoration and
   per-density sizing) lives in src/styles/resume.css so the one stylesheet
   owns the visual identity along both axes (ADR 0008). */
}
<div class="xp-list">
  {
    experience.map((job) => (
      <div class="xp-item">
        <div class="xp-head">
          <h3 class="xp-role">{job.role}</h3>
          <span class="xp-meta">
            {job.company}
            {job.location ? ` · ${job.location}` : ""}
            {" | "}
            {job.start} – {job.end}
          </span>
        </div>
        <ul class="xp-highlights">
          {job.highlights.map((h) => (
            <li>{h}</li>
          ))}
        </ul>
        {job.tech && job.tech.length > 0 && (
          <p class="xp-tech">{job.tech.join(" · ")}</p>
        )}
      </div>
    ))
  }
</div>
