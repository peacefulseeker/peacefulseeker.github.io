---
import type { CertificationEntry } from "../utils/resumeSchema";

interface Props {
  certifications: CertificationEntry[];
}

const { certifications } = Astro.props;
---

<div class="cert-list">
  {
    certifications.map((cert) => (
      <div class="cert-item">
        <h3>
          {cert.url ? (
            <a href={cert.url} target="_blank" rel="noopener noreferrer">
              {cert.name}
            </a>
          ) : (
            cert.name
          )}
        </h3>
        {cert.issuer && <p class="cert-issuer">{cert.issuer}</p>}
        {(cert.start || cert.end) && (
          <p class="cert-dates">
            {cert.start}
            {cert.end ? ` – ${cert.end}` : ""}
          </p>
        )}
        {cert.credentialId && <p class="cert-id">ID: {cert.credentialId}</p>}
      </div>
    ))
  }
</div>

<style>
  .cert-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cert-item {
    break-inside: avoid;
  }

  h3 {
    font-size: 0.95rem;
    font-weight: 600;
    color: #111827;
    margin: 0 0 0.1rem;
  }

  h3 a {
    color: #111827;
    text-decoration: none;
    border-bottom: 1px solid #bfdbfe;
    transition:
      color 0.15s,
      border-color 0.15s;
  }

  h3 a:hover {
    color: #2563eb;
    border-color: #2563eb;
  }

  .cert-issuer {
    font-size: 0.82rem;
    color: #374151;
    margin: 0 0 0.1rem;
  }

  .cert-dates {
    font-size: 0.75rem;
    font-weight: 600;
    color: #2563eb;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 0.1rem;
  }

  .cert-id {
    font-size: 0.72rem;
    color: #9ca3af;
    font-family: "Courier New", Courier, monospace;
    margin: 0;
  }

  @media print {
    h3 a {
      color: #111827;
      border-bottom: none;
      text-decoration: underline;
    }
  }
</style>
