---
import { THEME_NAMES } from "@utils/resumeSchema";
---

<!--
  Inline script — must be the first child of <body> so the theme class is
  swapped before first paint (FOUC-free). Also preserves ?template= in the
  density-toggle href so the theme survives a onepage ↔ full transition.
-->
<script is:inline define:vars={{ THEME_NAMES }}>
  (function () {
    var p = new URLSearchParams(location.search);
    var tpl = p.get("template");
    if (!tpl || !THEME_NAMES.includes(tpl)) return;

    document.body.className = document.body.className.replace(
      /\btheme-\w+\b/,
      "theme-" + tpl,
    );

    document.addEventListener("DOMContentLoaded", function () {
      var vt = document.querySelector(".version-toggle");
      if (!vt) return;
      var href = vt.getAttribute("href") || "";
      if (href && !href.includes("template=")) {
        vt.setAttribute("href", href + "?template=" + tpl);
      }
    });
  })();
</script>
