---
import { getResumeEntry } from "../../utils/getResumeEntry";
import { resolveOtherVersion } from "../../utils/resumeView";
import OnepageLayout from "../../layouts/OnepageLayout.astro";

// The one-page resume is the default resume view, served at /resume
// (see ADR 0006). The full version lives at /resume/full.
const resume = await getResumeEntry("onepage");
const { sidebarPosition } = resume.full_template;

const otherVersion = await resolveOtherVersion(
  "full",
  import.meta.env.BASE_URL,
);
---

<OnepageLayout
  name={resume.name}
  role={resume.role}
  profile={resume.profile}
  summary_short={resume.summary_short}
  skills={resume.skills}
  languages={resume.languages}
  experience={resume.experience}
  education={resume.education}
  certifications={resume.certifications}
  sidebarPosition={sidebarPosition}
  otherVersion={otherVersion}
>
  <resume.Content />
</OnepageLayout>
