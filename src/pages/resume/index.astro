---
import "../../styles/page-onepage.css";
import { getResumeEntry } from "../../utils/getResumeEntry";
import { resolveOtherVersion } from "../../utils/resumeView";
import ResumeLayout from "../../layouts/ResumeLayout.astro";

// The one-page resume is the default resume view, served at /resume (ADR 0006).
// It renders the same ResumeLayout as /resume/full, only at onepage density
// (ADR 0008): getResumeEntry("onepage") trims the content and the layout shows
// the compact spacing budget.
const { Content, theme, ...resumeData } = await getResumeEntry("onepage");

const otherVersion = await resolveOtherVersion(
  "full",
  import.meta.env.BASE_URL,
);
---

<ResumeLayout
  {...resumeData}
  theme={theme.name}
  density="onepage"
  sidebarPosition={theme.sidebarPosition}
  otherVersion={otherVersion}
>
  <Content />
</ResumeLayout>
