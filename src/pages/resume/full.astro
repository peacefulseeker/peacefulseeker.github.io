---
import { getResumeEntry } from "../../utils/getResumeEntry";
import {
  assertFullTemplate,
  resolveOtherVersion,
} from "../../utils/resumeView";
import type { FullTemplate } from "../../utils/resumeSchema";
import ClassicLayout from "../../layouts/ClassicLayout.astro";
import TimelineLayout from "../../layouts/TimelineLayout.astro";

// Every full-route template maps to a layout. Typing the record as
// Record<FullTemplate, …> makes adding a template to the schema a compile
// error here until its layout is wired up. CSS no longer needs a dynamic
// import to stay isolated — each template scopes its styles under a
// body.tpl-<name> root class (see the tpl-* convention in docs/adr), so both
// stylesheets can co-load on this page without colliding.
const LAYOUTS: Record<
  FullTemplate,
  typeof ClassicLayout | typeof TimelineLayout
> = {
  classic: ClassicLayout,
  timeline: TimelineLayout,
};

const { Content, full_template, ...resumeData } = await getResumeEntry("full");
const { name: templateName, ...templateOptions } = full_template;

assertFullTemplate(templateName);
const Layout = LAYOUTS[templateName];

const otherVersion = await resolveOtherVersion(
  "onepage",
  import.meta.env.BASE_URL,
);
---

<Layout {...resumeData} {...templateOptions} otherVersion={otherVersion}>
  <Content />
</Layout>
