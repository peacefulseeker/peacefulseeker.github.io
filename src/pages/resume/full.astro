---
import "../../styles/page-full.css";
import { getResumeEntry } from "../../utils/getResumeEntry";
import { resolveOtherVersion } from "../../utils/resumeView";
import ResumeLayout from "../../layouts/ResumeLayout.astro";

// The full resume, served at /resume/full (ADR 0006). Same ResumeLayout and
// same theme as /resume, only at full density (ADR 0008): all experience and
// highlights, generous spacing. The toggle reads as "same document, more
// detail" rather than a different template.
const { Content, theme, ...resumeData } = await getResumeEntry("full");

const otherVersion = await resolveOtherVersion(
  "onepage",
  import.meta.env.BASE_URL,
);
---

<ResumeLayout
  {...resumeData}
  theme={theme.name}
  density="full"
  sidebarPosition={theme.sidebarPosition}
  otherVersion={otherVersion}
>
  <Content />
</ResumeLayout>
