---
import {
  getResumeEntry,
  resumeVariantExists,
} from "../../utils/getResumeEntry";
import { TEMPLATE_NAMES } from "../../content.config";
import type { TemplateName } from "../../content.config";
import ClassicLayout from "../../layouts/ClassicLayout.astro";
import TimelineLayout from "../../layouts/TimelineLayout.astro";

const resume = await getResumeEntry("full");
const { name: templateName, ...templateOptions } = resume.template;

// The full route renders the classic/timeline templates; "onepage" is served
// from /resume (see ADR 0006), so it is intentionally excluded here.
type FullTemplate = Exclude<TemplateName, "onepage">;

const layouts = {
  classic: ClassicLayout,
  timeline: TimelineLayout,
} satisfies Record<FullTemplate, unknown>;

function isFullTemplate(t: TemplateName): t is FullTemplate {
  return t in layouts;
}

if (!isFullTemplate(templateName)) {
  throw new Error(
    `Unknown full-route template "${templateName}". Valid templates: ${TEMPLATE_NAMES.filter(
      (t) => t !== "onepage",
    ).join(", ")}`,
  );
}

const Layout = layouts[templateName];

const base = import.meta.env.BASE_URL;
const otherVersion = (await resumeVariantExists("onepage"))
  ? { href: `${base}resume/`, label: "One-page version" }
  : undefined;
---

<Layout
  name={resume.name}
  role={resume.role}
  contact={resume.contact}
  profile={resume.profile}
  skills={resume.skills}
  languages={resume.languages}
  hobbies={resume.hobbies}
  experience={resume.experience}
  education={resume.education}
  certifications={resume.certifications}
  otherVersion={otherVersion}
  {...templateOptions}
>
  <resume.Content />
</Layout>
