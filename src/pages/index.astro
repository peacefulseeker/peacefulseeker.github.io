---
import { getResumeEntry } from "../utils/getResumeEntry";
import { TEMPLATE_NAMES } from "../content.config";
import type { TemplateName } from "../content.config";
import ClassicLayout from "../layouts/ClassicLayout.astro";
import TimelineLayout from "../layouts/TimelineLayout.astro";

const resume = await getResumeEntry();
const { name: templateName, ...templateOptions } = resume.template;

const layouts = {
  classic: ClassicLayout,
  timeline: TimelineLayout,
} satisfies Record<TemplateName, unknown>;

if (!(templateName in layouts)) {
  throw new Error(
    `Unknown template "${templateName}". Valid templates: ${TEMPLATE_NAMES.join(", ")}`,
  );
}

const Layout = layouts[templateName];
---

<Layout
  name={resume.name}
  role={resume.role}
  contact={resume.contact}
  profile={resume.profile}
  skills={resume.skills}
  languages={resume.languages}
  hobbies={resume.hobbies}
  experience={resume.experience}
  education={resume.education}
  certifications={resume.certifications}
  {...templateOptions}
>
  <resume.Content />
</Layout>
