---
import "../styles/classic.css";
import FaviconLinks from "../components/FaviconLinks.astro";
import ResumeHeader from "../components/ResumeHeader.astro";
import Timeline from "../components/Timeline.astro";
import EducationList from "../components/EducationList.astro";
import Certifications from "../components/Certifications.astro";
import type { ResumeData } from "../utils/resumeSchema";

type Props = Omit<ResumeData, "template"> & {
  otherVersion?: { href: string; label: string };
};

const props = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{props.name} — Resume</title>
    <meta name="description" content={`${props.name} — ${props.role}`} />
    <FaviconLinks />
  </head>
  <body>
    <main>
      <ResumeHeader
        name={props.name}
        role={props.role}
        contact={props.contact ?? []}
        otherVersion={props.otherVersion}
      />

      <slot />

      {
        props.experience && props.experience.length > 0 && (
          <section>
            <h2>Experience</h2>
            <Timeline experience={props.experience} />
          </section>
        )
      }

      {
        props.education && props.education.length > 0 && (
          <section>
            <h2>Education</h2>
            <EducationList education={props.education} />
          </section>
        )
      }

      {
        props.certifications && props.certifications.length > 0 && (
          <section>
            <h2>Certifications &amp; Extra-curricular</h2>
            <Certifications certifications={props.certifications} />
          </section>
        )
      }
    </main>
  </body>
</html>
