---
/*
 * BaseLayout is not used by the built-in templates (classic, timeline
 * are each self-contained). Kept as a starting point for custom templates.
 */
import FaviconLinks from "../components/FaviconLinks.astro";
import ResumeHeader from "../components/ResumeHeader.astro";

interface Props {
  name: string;
  role: string;
  contact?: Array<{ value: string }>;
}

const { name, role, contact } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{name} — Resume</title>
    <FaviconLinks />
  </head>
  <body>
    <main>
      <ResumeHeader name={name} role={role} contact={contact ?? []} />
      <slot />
    </main>
  </body>
</html>
